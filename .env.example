# Copy to .env and fill in. Used by IngressScript/app.py.

# Hugging Face read token: https://huggingface.co/settings/tokens
# (fine-grained tokens need "Read access to contents of all public gated repos")
# and accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Recorder sync (the "Sync" button on the home page):
#   copy = recordings stay on the recorder too (default)
#   move = each recording is deleted from the recorder once its copy has been checked
SYNC_MODE=copy
# Extra folders to look for a recorder in, separated by ; (drives are found automatically)
# SYNC_SOURCES=F:\backup-recorder

# Language, auto-transcribe and rustle cleanup are chosen on the home page (Setup / Settings).
# These only set the starting values:
# LANGUAGE=en
# RUSTLE_STRENGTH=1

# Optional: viewer port (default 5000)
# PORT=5000

# Optional: override data locations
# (defaults: ../RECORD, IngressScript/processed_daily, IngressScript/speaker_memory.db)
# RECORD_DIR=E:\RECORD
# OUTPUT_DIR=C:\Users\me\Documents\processed_daily
# SPEAKER_DB=C:\Users\me\Documents\speaker_memory.db
