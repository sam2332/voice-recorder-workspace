# Copy to .env and fill in. Used by IngressScript/app.py and by docker compose.

# Hugging Face read token: https://huggingface.co/settings/tokens
# (fine-grained tokens need "Read access to contents of all public gated repos")
# and accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Optional: skip language detection (e.g. en, de, fr)
# LANGUAGE=en

# Optional: clothing-rustle suppression (1 = full, 0.5 = gentler, 0 = off)
# RUSTLE_STRENGTH=1

# Docker only: where the recordings are on this computer (default ./RECORD), and the port
# RECORD_PATH=E:/RECORD
# PORT=5000

# Local runs only: override data locations
# (defaults: ../RECORD, IngressScript/processed_daily, IngressScript/speaker_memory.db)
# RECORD_DIR=E:\RECORD
# OUTPUT_DIR=C:\Users\me\Documents\processed_daily
# SPEAKER_DB=C:\Users\me\Documents\speaker_memory.db
